# ==============================================================================
# BlockchainForkTree: Production Environment Configuration
# ==============================================================================

# Application Server
PORT=3000
NODE_ENV=production

# Blockchain Network Deployment Target: [localhost | sepolia | holesky | besu_consortium]
NETWORK_TARGET=localhost

# RPC Endpoints for Live Networks
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
HOLESKY_RPC_URL=https://ethereum-holesky-rpc.publicnode.com
BESU_CONSORTIUM_RPC_URL=http://besu-validator-1.internal:8545

# Cryptographic Keys (Use AWS KMS / HashiCorp Vault in strict enterprise deployments)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Hybrid Off-Chain Encryption Vault Secret (HIPAA AES-256-GCM Master Key)
STORAGE_ENCRYPTION_SECRET=consortium-production-hipaa-secure-key-2026

# IPFS Gateway / Cluster Endpoint for Off-Chain Encrypted Documents
IPFS_GATEWAY_URL=http://127.0.0.1:5001/api/v0
